{
  "schema_version": 1,
  "quilt_loader": {
    "group": "io.ejekta",
    "id": "${mod_id}",
    "version": "${version}",
    "metadata": {
      "name": "${mod_name}",
      "description": "${mod_description}",
      "contributors": {
        "${mod_authors}": "Author",
        "AkiShirai": "Board block art",
        "Zano1999": "Translations",
        "GodGun968": "Translations"
      },
      "contact": {
        "homepage": "${mod_homepage}",
        "sources": "${mod_homepage}",
        "issues": "${mod_issues}"
      },
      "license": "${mod_license}",
      "icon": "assets/${mod_id}/icon.png"
    },
    "intermediate_mappings": "net.fabricmc:intermediary",
    "entrypoints": {
      "init": [
        "io.ejekta.bountiful.BountifulModFabric"
      ],
      "client_init": [
        "io.ejekta.bountiful.client.BountifulClient"
      ]
    },
    "depends": [
      {
        "id": "quilt_loader",
        "versions": ">=${quilt_loader_version}"
      },
      {
        "id": "minecraft",
        "versions": ">=${minecraft_version}"
      },
      {
        "id": "java",
        "versions": ">=${java_runtime_version}"
      },
      {
        "id": "fabric-language-kotlin",
        "versions": ">=1.14.0"
      }
    ]
  },
  "minecraft": {
    "environment": "*"
  },
  "access_widener": "bountiful.accesswidener",
  "mixin": [
    "bountiful.mixins.json",
    "bountiful-kambrik.mixins.json"
  ]
}
